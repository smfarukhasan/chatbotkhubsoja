  @@unique([account_id, user_id], map: "uq_account_users_account_id_user_id")
  @@index([account_id], map: "ix_account_users_account_id")
  @@index([id], map: "ix_account_users_id")
  @@index([invited_email], map: "ix_account_users_invited_email")
  @@index([is_active], map: "ix_account_users_is_active")
  @@index([role_id], map: "ix_account_users_role_id")
  @@index([user_id], map: "ix_account_users_user_id")
}

