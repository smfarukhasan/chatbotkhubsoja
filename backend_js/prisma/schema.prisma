  @@index([ends_at], map: "ix_account_subscriptions_ends_at")
  @@index([external_subscription_id], map: "ix_account_subscriptions_external_subscription_id")
  @@index([id], map: "ix_account_subscriptions_id")
  @@index([renews_at], map: "ix_account_subscriptions_renews_at")
  @@index([starts_at], map: "ix_account_subscriptions_starts_at")
  @@index([status], map: "ix_account_subscriptions_status")
}

model account_users {
  id            Int      @id @default(autoincrement())
  account_id    Int
  user_id       Int
  role_id       Int?
  invited_email String?  @db.VarChar(255)
  is_active     Boolean
  created_at    DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
