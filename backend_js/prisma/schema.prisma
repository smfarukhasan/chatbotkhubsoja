  @@index([ai_prompt_id], map: "ix_social_posts_ai_prompt_id")
  @@index([approved_by_user_id], map: "ix_social_posts_approved_by_user_id")
  @@index([created_by_user_id], map: "ix_social_posts_created_by_user_id")
  @@index([external_post_id], map: "ix_social_posts_external_post_id")
  @@index([id], map: "ix_social_posts_id")
  @@index([platform_connection_id], map: "ix_social_posts_platform_connection_id")
  @@index([platform_type], map: "ix_social_posts_platform_type")
  @@index([rejected_by_user_id], map: "ix_social_posts_rejected_by_user_id")
