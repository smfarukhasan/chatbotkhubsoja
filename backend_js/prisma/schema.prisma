  @@index([id], map: "ix_action_usage_logs_id")
  @@index([occurred_at], map: "ix_action_usage_logs_occurred_at")
  @@index([platform_connection_id], map: "ix_action_usage_logs_platform_connection_id")
  @@index([platform_type], map: "ix_action_usage_logs_platform_type")
  @@index([reference_id], map: "ix_action_usage_logs_reference_id")
