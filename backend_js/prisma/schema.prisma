generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                   Int                        @id @default(autoincrement())
  email                                                String                     @unique(map: "ix_users_email") @db.VarChar(255)
  fullName                                             String?                    @map("full_name") @db.VarChar(255)
  hashedPassword                                       String                     @map("hashed_password") @db.VarChar(255)
  isActive                                             Boolean                    @default(true) @map("is_active")
  isSuperuser                                          Boolean                    @default(false) @map("is_superuser")
  status                                               UserStatus                 @default(ACTIVE)
  createdAt                                            DateTime                   @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt                                            DateTime                   @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  userRole                                             UserRole                   @default(ADMIN) @map("user_role")
  managedByUserId                                      Int?                       @map("managed_by_user_id")
  permissionsJson                                      Json?                      @map("permissions_json")
  account_users                                        account_users[]
  action_usage_logs                                    action_usage_logs[]
  audit_logs                                           audit_logs[]
  conversations                                        conversations[]
  facebook_comment_replies                             facebook_comment_replies[]
  facebook_comments                                    facebook_comments[]
  llm_token_usage                                      llm_token_usage[]
  memberships                                          Membership[]
  messages                                             messages[]
  refreshTokens                                        RefreshToken[]
  social_posts_social_posts_approved_by_user_idTousers social_posts[]             @relation("social_posts_approved_by_user_idTousers")
  social_posts_social_posts_created_by_user_idTousers  social_posts[]             @relation("social_posts_created_by_user_idTousers")
  social_posts_social_posts_rejected_by_user_idTousers social_posts[]             @relation("social_posts_rejected_by_user_idTousers")
  managedByUser                                        User?                      @relation("UserManager", fields: [managedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_managed_by_user_id_users")
  managedUsers                                         User[]                     @relation("UserManager")

  @@index([id], map: "ix_users_id")
  @@index([managedByUserId], map: "ix_users_managed_by_user_id")
  @@index([userRole], map: "ix_users_user_role")
  @@map("users")
}

model Account {
  id                       Int                        @id @default(autoincrement())
  name                     String                     @db.VarChar(255)
  slug                     String                     @unique(map: "ix_accounts_slug") @db.VarChar(100)
  isActive                 Boolean                    @default(true) @map("is_active")
  createdAt                DateTime                   @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime                   @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  tokenBalance             Int                        @map("token_balance")
  monthlyTokenCredit       Int                        @map("monthly_token_credit")
  tokenCreditLastAppliedAt DateTime?                  @map("token_credit_last_applied_at") @db.DateTime(0)
  tokenCreditNextResetAt   DateTime?                  @map("token_credit_next_reset_at") @db.DateTime(0)
  profile_image_url        String?                    @db.Text
  account_subscriptions    account_subscriptions[]
  account_users            account_users[]
  action_usage_logs        action_usage_logs[]
  ai_agents                ai_agents[]
  ai_knowledge_sources     ai_knowledge_sources[]
  ai_prompts               ai_prompts[]
  audit_logs               audit_logs[]
  automation_workflows     automation_workflows[]
  billing_transactions     billing_transactions[]
  conversations            conversations[]
  facebook_comment_replies facebook_comment_replies[]
  facebook_comments        facebook_comments[]
  faq_knowledge            faq_knowledge[]
  llm_token_usage          llm_token_usage[]
  memberships              Membership[]
  messages                 messages[]
  onboardingKeys           OnboardingKey[]
  platformConnections      PlatformConnection[]
  social_posts             social_posts[]
  sync_jobs                sync_jobs[]
  token_ledger             token_ledger[]
  token_wallets            token_wallets?
  webhookEvents            WebhookEvent[]

  @@index([id], map: "ix_accounts_id")
  @@index([tokenCreditNextResetAt], map: "ix_accounts_token_credit_next_reset_at")
  @@map("accounts")
}

model Membership {
  id           Int              @id @default(autoincrement())
  accountId    Int              @map("account_id")
  userId       Int              @map("user_id")
  role         memberships_role @default(MEMBER)
  status       MembershipStatus @default(ACTIVE)
  invitedEmail String?          @map("invited_email") @db.VarChar(255)
  createdAt    DateTime         @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime         @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  account      Account          @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_memberships_account_id_accounts")
  user         User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_memberships_user_id_users")

  @@unique([accountId, userId], name: "uq_memberships_account_id_user_id", map: "uq_memberships_account_id_user_id")
  @@index([accountId], map: "ix_memberships_account_id")
  @@index([id], map: "ix_memberships_id")
  @@index([userId], map: "ix_memberships_user_id")
  @@map("memberships")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenJti  String    @unique(map: "ix_refresh_tokens_token_jti") @map("token_jti") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt DateTime  @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_refresh_tokens_user_id_users")

  @@index([id], map: "ix_refresh_tokens_id")
  @@index([userId], map: "ix_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model OnboardingKey {
  id           Int                  @id @default(autoincrement())
  accountId    Int                  @map("account_id")
  key          String               @unique(map: "ix_onboarding_keys_key") @db.VarChar(64)
  role         onboarding_keys_role @default(MEMBER)
  maxUses      Int                  @default(1) @map("max_uses")
  usedCount    Int                  @default(0) @map("used_count")
  expiresAt    DateTime?            @map("expires_at") @db.DateTime(0)
  revokedAt    DateTime?            @map("revoked_at") @db.DateTime(0)
  invitedEmail String?              @map("invited_email") @db.VarChar(255)
  createdAt    DateTime             @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime             @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  account      Account              @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_onboarding_keys_account_id_accounts")

  @@index([accountId], map: "ix_onboarding_keys_account_id")
  @@index([id], map: "ix_onboarding_keys_id")
  @@map("onboarding_keys")
}

model PlatformConnection {
  id                    Int                    @id @default(autoincrement())
  accountId             Int                    @map("account_id")
  platformType          PlatformType           @map("platform_type")
  name                  String                 @db.VarChar(255)
  externalId            String?                @map("external_id") @db.VarChar(255)
  externalName          String?                @map("external_name") @db.VarChar(255)
  status                ConnectionStatus       @default(PENDING)
  encryptedAccessToken  String?                @map("encrypted_access_token") @db.VarChar(2048)
  encryptedRefreshToken String?                @map("encrypted_refresh_token") @db.VarChar(2048)
  tokenHint             String?                @map("token_hint") @db.VarChar(16)
  webhookUrl            String?                @map("webhook_url") @db.VarChar(500)
  webhookSecret         String?                @map("webhook_secret") @db.VarChar(255)
  webhookVerifyToken    String?                @map("webhook_verify_token") @db.VarChar(255)
  webhookActive         Boolean                @default(false) @map("webhook_active")
  metadataJson          Json                   @map("metadata_json")
  settingsJson          Json                   @map("settings_json")
  lastError             String?                @map("last_error") @db.VarChar(500)
  createdAt             DateTime               @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime               @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  action_usage_logs     action_usage_logs[]
  ai_agents             ai_agents[]
  ai_prompts            ai_prompts[]
  automation_workflows  automation_workflows[]
  conversations         conversations[]
  facebook_comments     facebook_comments[]
  llm_token_usage       llm_token_usage[]
  account               Account                @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_platform_connections_account_id_accounts")
  social_posts          social_posts[]
  sync_jobs             sync_jobs[]
  webhookEvents         WebhookEvent[]

  @@index([accountId], map: "ix_platform_connections_account_id")
  @@index([externalId], map: "ix_platform_connections_external_id")
  @@index([id], map: "ix_platform_connections_id")
  @@index([platformType], map: "ix_platform_connections_platform_type")
  @@map("platform_connections")
}

model WebhookEvent {
  id                   Int                 @id @default(autoincrement())
  accountId            Int?                @map("account_id")
  platformConnectionId Int?                @map("platform_connection_id")
  platformType         PlatformType        @map("platform_type")
  source               WebhookEventSource
  status               WebhookEventStatus  @default(PENDING)
  eventType            String              @map("event_type") @db.VarChar(100)
  eventKey             String              @unique(map: "uq_webhook_events_event_key") @map("event_key") @db.VarChar(255)
  deliveryId           String?             @map("delivery_id") @db.VarChar(255)
  attempts             Int                 @default(0)
  receivedAt           DateTime            @map("received_at") @db.DateTime(0)
  processingStartedAt  DateTime?           @map("processing_started_at") @db.DateTime(0)
  processedAt          DateTime?           @map("processed_at") @db.DateTime(0)
  lastTaskId           String?             @map("last_task_id") @db.VarChar(255)
  errorMessage         String?             @map("error_message") @db.VarChar(500)
  payloadJson          Json                @map("payload_json")
  headersJson          Json                @map("headers_json")
  metadataJson         Json                @map("metadata_json")
  createdAt            DateTime            @default(dbgenerated("(now())")) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime            @default(dbgenerated("(now())")) @updatedAt @map("updated_at") @db.DateTime(0)
  account              Account?            @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_webhook_events_account_id_accounts")
  platformConnection   PlatformConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_webhook_events_platform_connection_id_platform_connections")

  @@index([accountId], map: "ix_webhook_events_account_id")
  @@index([deliveryId], map: "ix_webhook_events_delivery_id")
  @@index([eventType], map: "ix_webhook_events_event_type")
  @@index([id], map: "ix_webhook_events_id")
  @@index([platformConnectionId], map: "ix_webhook_events_platform_connection_id")
  @@index([platformType], map: "ix_webhook_events_platform_type")
  @@index([processedAt], map: "ix_webhook_events_processed_at")
  @@index([receivedAt], map: "ix_webhook_events_received_at")
  @@index([source], map: "ix_webhook_events_source")
  @@index([status], map: "ix_webhook_events_status")
  @@map("webhook_events")
}

model account_subscription_feature_snapshot {
  id                      Int                   @id @default(autoincrement())
  account_subscription_id Int
  feature_catalog_id      Int
  feature_code            String                @db.VarChar(100)
  feature_name            String                @db.VarChar(255)
  included_value          Decimal               @db.Decimal(14, 4)
  config_json             Json
  created_at              DateTime              @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at              DateTime              @default(dbgenerated("(now())")) @db.DateTime(0)
  account_subscriptions   account_subscriptions @relation(fields: [account_subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_account_subscription_feature_snapshot_account_subscri_84ce")
  feature_catalog         feature_catalog       @relation(fields: [feature_catalog_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_account_subscription_feature_snapshot_feature_catalog_6aac")

  @@unique([account_subscription_id, feature_catalog_id], map: "uq_account_subscription_feature_snapshot_subscription_feature")
  @@index([account_subscription_id], map: "ix_account_subscription_feature_snapshot_account_subscription_id")
  @@index([feature_catalog_id], map: "ix_account_subscription_feature_snapshot_feature_catalog_id")
  @@index([feature_code], map: "ix_account_subscription_feature_snapshot_feature_code")
  @@index([id], map: "ix_account_subscription_feature_snapshot_id")
}

model account_subscriptions {
  id                                    Int                                     @id @default(autoincrement())
  account_id                            Int
  billing_plan_id                       Int
  status                                account_subscriptions_status
  starts_at                             DateTime                                @db.DateTime(0)
  ends_at                               DateTime?                               @db.DateTime(0)
