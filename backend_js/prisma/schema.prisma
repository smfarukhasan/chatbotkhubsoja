model sync_jobs {
  id                     Int                 @id @default(autoincrement())
  account_id             Int?
  platform_connection_id Int?
  status                 sync_jobs_status    @default(PENDING)
  job_type               sync_jobs_job_type
  dedupe_key             String?             @unique(map: "uq_sync_jobs_dedupe_key") @db.VarChar(255)
  scheduled_for          DateTime            @db.DateTime(0)
  retry_after            DateTime?           @db.DateTime(0)
  started_at             DateTime?           @db.DateTime(0)
  completed_at           DateTime?           @db.DateTime(0)
  attempts               Int                 @default(0)
  max_attempts           Int                 @default(5)
  last_task_id           String?             @db.VarChar(255)
  error_message          String?             @db.VarChar(500)
  payload_json           Json
  result_json            Json
  created_at             DateTime            @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at             DateTime            @default(dbgenerated("(now())")) @db.DateTime(0)
  accounts               Account?            @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sync_jobs_account_id_accounts")
  platform_connections   PlatformConnection? @relation(fields: [platform_connection_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_sync_jobs_platform_connection_id_platform_connections")

  @@index([account_id], map: "ix_sync_jobs_account_id")
  @@index([id], map: "ix_sync_jobs_id")
  @@index([job_type], map: "ix_sync_jobs_job_type")
  @@index([platform_connection_id], map: "ix_sync_jobs_platform_connection_id")
  @@index([retry_after], map: "ix_sync_jobs_retry_after")
  @@index([scheduled_for], map: "ix_sync_jobs_scheduled_for")
  @@index([status], map: "ix_sync_jobs_status")
}

model token_ledger {
  id                      Int                           @id @default(autoincrement())
  token_wallet_id         Int
  account_id              Int
  account_subscription_id Int?
  billing_transaction_id  Int?
  entry_type              token_ledger_entry_type
  source_type             token_ledger_source_type
  delta_tokens            Int
  balance_before          Int
  balance_after           Int
  unit_price_usd          Decimal?                      @db.Decimal(12, 6)
  total_price_usd         Decimal?                      @db.Decimal(12, 4)
  reference_type          String?                       @db.VarChar(100)
  reference_id            String?                       @db.VarChar(255)
  notes                   String?                       @db.VarChar(500)
  occurred_at             DateTime                      @db.DateTime(0)
  metadata_json           Json
  created_at              DateTime                      @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at              DateTime                      @default(dbgenerated("(now())")) @db.DateTime(0)
  allocation_type         token_ledger_allocation_type?
  remaining_tokens        Int?
  expires_at              DateTime?                     @db.DateTime(0)
  expired_at              DateTime?                     @db.DateTime(0)
  is_expired              Boolean
  accounts                Account                       @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_token_ledger_account_id_accounts")
  account_subscriptions   account_subscriptions?        @relation(fields: [account_subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_token_ledger_account_subscription_id_account_subscriptions")
  billing_transactions    billing_transactions?         @relation(fields: [billing_transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_token_ledger_billing_transaction_id_billing_transactions")
  token_wallets           token_wallets                 @relation(fields: [token_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_token_ledger_token_wallet_id_token_wallets")

  @@index([account_id], map: "ix_token_ledger_account_id")
  @@index([account_subscription_id], map: "ix_token_ledger_account_subscription_id")
  @@index([allocation_type], map: "ix_token_ledger_allocation_type")
  @@index([billing_transaction_id], map: "ix_token_ledger_billing_transaction_id")
  @@index([entry_type], map: "ix_token_ledger_entry_type")
  @@index([expires_at], map: "ix_token_ledger_expires_at")
  @@index([id], map: "ix_token_ledger_id")
  @@index([is_expired], map: "ix_token_ledger_is_expired")
  @@index([occurred_at], map: "ix_token_ledger_occurred_at")
  @@index([reference_id], map: "ix_token_ledger_reference_id")
  @@index([reference_type], map: "ix_token_ledger_reference_type")
  @@index([source_type], map: "ix_token_ledger_source_type")
  @@index([token_wallet_id], map: "ix_token_ledger_token_wallet_id")
}

model token_purchase_packages {
  id                   Int                    @id @default(autoincrement())
  code                 String                 @unique(map: "ix_token_purchase_packages_code") @db.VarChar(100)
  name                 String                 @db.VarChar(255)
  description          String?                @db.VarChar(500)
  token_amount         Int
  bonus_tokens         Int
  price_usd            Decimal                @db.Decimal(10, 2)
  currency             String                 @db.VarChar(8)
  is_active            Boolean
  metadata_json        Json
  created_at           DateTime               @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at           DateTime               @default(dbgenerated("(now())")) @db.DateTime(0)
  billing_transactions billing_transactions[]

  @@index([id], map: "ix_token_purchase_packages_id")
  @@index([is_active], map: "ix_token_purchase_packages_is_active")
}

model token_wallets {
  id                       Int                  @id @default(autoincrement())
  account_id               Int                  @unique(map: "uq_token_wallets_account_id")
  status                   token_wallets_status
  balance_tokens           Int
  reserved_tokens          Int
  lifetime_credited_tokens Int
  lifetime_debited_tokens  Int
  metadata_json            Json
  created_at               DateTime             @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at               DateTime             @default(dbgenerated("(now())")) @db.DateTime(0)
  token_ledger             token_ledger[]
  accounts                 Account              @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_token_wallets_account_id_accounts")

  @@index([account_id], map: "ix_token_wallets_account_id")
  @@index([id], map: "ix_token_wallets_id")
  @@index([status], map: "ix_token_wallets_status")
}

